        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "UNANIMOUS",
        "resources": [
          {
            "_id": "9c5c2c3f-ef9f-46e8-9a17-d9df0ad6f0c1",
            "name": "transfer",
            "displayName": "Transfer",
            "type": "urn:minilab:resources:transfer",
            "ownerManagedAccess": false,
            "uris": [
              "/transfer"
            ],
            "scopes": [
              {
                "name": "transfer:write"
              }
            ]
          }
        ],
        "scopes": [
          {
            "id": "5187c6ba-3d2c-4be0-a1de-bfd9bb1ce111",
            "name": "transfer:write",
            "displayName": "Write transfers"
          },
          {
            "id": "208465ad-48ca-4e5f-9898-aaf3fd1699a1",
            "name": "balance:read",
            "displayName": "Read balances"
          },
          {
            "id": "68c6f5e7-a5f3-46e6-99f8-923a4902fb13",
            "name": "userlist:view",
            "displayName": "View users"
          }
        ],
        "policies": [
          {
            "id": "3975402e-2af5-40bf-afbd-c2758bc18971",
            "name": "Transfer writers",
            "description": "Allows users with the transfer:write client role.",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"a8ee07d1-db16-48cf-af14-3f2ec1eb7e42\",\"required\":false}]"
            }
          },
          {
            "id": "64c1f89f-8892-4431-b604-af72fdd4011f",
            "name": "Transfer write permission",
            "description": "Protects the transfer resource write scope.",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"9c5c2c3f-ef9f-46e8-9a17-d9df0ad6f0c1\"]",
              "scopes": "[\"5187c6ba-3d2c-4be0-a1de-bfd9bb1ce111\"]",
              "applyPolicies": "[\"3975402e-2af5-40bf-afbd-c2758bc18971\"]"
            }
          }
        ]
      }
    },
    {
      "clientId": "user-lookup",
      "name": "User Lookup Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
